{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "files": {
    "includes": ["**/*.ts", "**/*.js", "**/*.mjs", "!**/node_modules", "!src/backup.ts", "!**/fixtures"]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 320, "lineEnding": "lf" },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all", "arrowParentheses": "always" } },
  "linter": { "enabled": false },
  "assist": { "enabled": false }
}
