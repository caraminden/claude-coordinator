# One connection to citadel-android-starter.socket (#381): start the emulator's service and say so.
[Unit]
Description=Start Citadel's shared Android emulator for a turn

[Service]
Type=oneshot
StandardOutput=socket
StandardError=journal
ExecStart=/usr/bin/systemctl --user start --no-block citadel-android.service
ExecStart=/usr/bin/echo "asked the host to start citadel-android.service"
