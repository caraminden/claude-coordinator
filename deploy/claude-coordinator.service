[Unit]
Description=Citadel web app
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# The database, its backups and session state are private to this account.
UMask=0077
WorkingDirectory=%h/claude-coordinator
# argv[0] is citadel-server, not node: ananicy-cpp names processes by argv[0], and CachyOS's rule for
# node runs it at nice 16 under SCHED_IDLE, so the server lost every CPU race to a build (#326).
ExecStart=@/usr/bin/node citadel-server %h/claude-coordinator/server.ts
EnvironmentFile=%h/.config/claude-coordinator/env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOST=127.0.0.1 PORT=8573
# Node's compile cache: boot to listening drops from about 1.4 s to 0.6 s, and every request waits that long in the
# socket on each restart (#1578). Node makes the folder (about 7 MB), checks each entry against its file, and skips the
# cache if it can't write there. Turns don't inherit it (turnEnv's allowlist).
Environment=NODE_COMPILE_CACHE=%h/.cache/citadel-server-compile-cache
# always, not on-failure: a stray SIGTERM (a turn's pkill) makes a clean exit, which on-failure leaves down.
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
