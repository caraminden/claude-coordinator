<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into every app that pins the shell (#1138). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Push: Android 13+ asks the person, and only when the app's page calls enablePush(). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Starts Firebase from capacitor.config.json's plugins.CitadelShell.firebase before any push arrives,
             so an app needs no google-services.json. After Firebase's own provider (initOrder 100). -->
        <provider
            android:name="zip.citadel.shell.ShellInit"
            android:authorities="${applicationId}.citadelshell"
            android:exported="false"
            android:initOrder="50" />

        <service
            android:name="zip.citadel.shell.ShellMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
