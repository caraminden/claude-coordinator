{
  "description": "Citadel kit hooks: the job check (with the answer check), the retro log, the test-first reminder, the any nudge, the flail brake and the seen guard (those five after a call run in one process, hooks/run.ts), the grunt-model guard and the after-compact reminder (kit/README.md).",
  "hooks": {
    "SessionStart": [
      { "matcher": "compact", "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/after-compact.sh\"", "timeout": 30 }] }
    ],
    "PreToolUse": [
      { "matcher": "^(Agent|Task)$", "hooks": [{ "type": "command", "command": "NODE_COMPILE_CACHE=\"$CITADEL_HOOK_CACHE\" node \"${CLAUDE_PLUGIN_ROOT}/hooks/grunt-model.ts\"", "timeout": 10 }] }
    ],
    "PostToolUse": [
      { "matcher": "^(Bash|Read|Grep|Glob|Write|Edit|MultiEdit|NotebookEdit)$", "hooks": [{ "type": "command", "command": "NODE_COMPILE_CACHE=\"$CITADEL_HOOK_CACHE\" node \"${CLAUDE_PLUGIN_ROOT}/hooks/run.ts\"", "timeout": 10 }] }
    ],
    "PostToolUseFailure": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "NODE_COMPILE_CACHE=\"$CITADEL_HOOK_CACHE\" node \"${CLAUDE_PLUGIN_ROOT}/hooks/run.ts\"", "timeout": 10 }] }
    ],
    "Stop": [
      { "hooks": [
        { "type": "command", "command": "NODE_COMPILE_CACHE=\"$CITADEL_HOOK_CACHE\" node \"${CLAUDE_PLUGIN_ROOT}/hooks/job-check.ts\"", "timeout": 10 },
        { "type": "command", "command": "NODE_COMPILE_CACHE=\"$CITADEL_HOOK_CACHE\" node \"${CLAUDE_PLUGIN_ROOT}/hooks/retro-log.ts\"", "timeout": 10 }
      ] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "NODE_COMPILE_CACHE=\"$CITADEL_HOOK_CACHE\" node \"${CLAUDE_PLUGIN_ROOT}/hooks/retro-log.ts\"", "timeout": 10 }] }
    ]
  }
}
