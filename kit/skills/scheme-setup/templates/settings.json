{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/tools/guard.sh --install", "timeout": 30 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/tools/guard.sh --hook bash", "timeout": 30 }
        ]
      },
      {
        "matcher": "^mcp__.*__(push_files|create_or_update_file|delete_file)$",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/tools/guard.sh --hook github", "timeout": 30 }
        ]
      }
    ]
  }
}
