{
  "name": "claude-coordinator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared web UI that runs headless Claude Code sessions as minions",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.ts",
    "test": "tools/citadel-node --test --test-concurrency=${CITADEL_TEST_CONCURRENCY:-$(( ($(nproc) + 1) / 2 ))} --test-global-setup=test/leak-guard.ts test/"
  }
}
