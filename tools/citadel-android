#!/usr/bin/env bash
# The shared headless Android emulator (#381), one AVD (`citadel`) for every scheme:
#   citadel-android up | install <apk> | open <url> | shot <file.png> | offline on|off | sms <from> <text> | down
# Since #533 the emulator runs on Cara's desktop, in the WSL distro citadel-android (deploy/desktop/android/),
# and turns still run here on perigee. perigee can't open a connection to the desktop, so the desktop dials
# in: its SSH tunnel puts the starter (127.0.0.1:$STARTER) and the emulator's console and adb ports
# (127.0.0.1:5554 and :5555) on perigee's loopback. The adb server stays on perigee
# (citadel-android-adb.service, `adb-serve`), so the device is emulator-5554 as before and `adb reverse`
# and `adb forward` end here, where the dev servers are. While the desktop is asleep, off or logged out
# the starter doesn't answer, and `up` says so.
# The emulator runs in citadel-android.service there, never always-on: `serve` (its main process) stops it
# after IDLE seconds unused. `up` and every finished step connect to the starter, which starts the service
# and marks it used. Container turns share the host's network, so all of this reaches them too.
# perigee's own units (deploy/citadel-android.service and its starter socket) still work as the way back:
# with that socket on :$STARTER instead of the tunnel, the emulator runs here.
# The screen is one lock in citadel-heavy's folder ($CITADEL_HEAVY_DIR): each step holds a flock, and its
# holder keeps the screen for LEASE seconds after a step, so its next step (install, open, shot) comes
# before anyone else's. Others wait and say for whom; nothing ever kills another holder's work.
# Console steps (sms, #442) need the console's token in the host's ~/.emulator_console_auth_token, which
# turns can't read. The step drops a request file in the lock folder (private to this account) and `serve`,
# which runs on the host, checks it again, sends it to the console and leaves the answer beside it.
set -uo pipefail

say() { echo "citadel-android: $*" >&2; }
SDK=${ANDROID_HOME:-$HOME/.local/share/android-sdk}
ADB="$SDK/platform-tools/adb"
AVD=citadel
CONSOLE=${CITADEL_ANDROID_PORT:-5554} # rehearsals only: a second emulator beside the shared one
SERIAL="emulator-$CONSOLE"
STARTER=${CITADEL_ANDROID_STARTER:-18590}
IDLE=${CITADEL_ANDROID_IDLE:-900}
LEASE=120
BOOT_WAIT=360
ADB_PORT=${ANDROID_ADB_SERVER_PORT:-5037} # adb's own variable
dir=${CITADEL_HEAVY_DIR:-$HOME/.local/share/claude-coordinator/projects/.heavy}
who=${CITADEL_HEAVY_WHO:-$(id -un 2>/dev/null || echo someone)}
lock="$dir/android.lock" holder="$dir/android.who" used="$dir/android.used"
CONSOLE_PORT=${CITADEL_ANDROID_CONSOLE_PORT:-$CONSOLE} # tests only
SMS_MAX=500

# 9>&-: an adb that finds no server starts one, which would hold the screen lock for as long as it runs (#496).
adb() { "$ADB" -s "$SERIAL" "$@" 9>&-; }
port_open() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }
# A quick question to the emulator. The time limit is for a desktop that went to sleep: its tunnel's ports
# stay open here for a while, and a question into them would never come back.
ask() { timeout 5 "$ADB" -s "$SERIAL" "$@" 9>&-; }
booted() { port_open "$ADB_PORT" && [ "$(ask shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = 1 ]; }
# The adb server must be the service's: one started from a container has another key, and the emulator refuses it.
need_server() { port_open "$ADB_PORT" || { say "the emulator isn't up; run citadel-android up"; exit 1; }; }
# Tells the adb server here to look at the emulator's adb port, in adb's own words (an emulator on this
# computer says the same when it starts). The server only looks by itself when it starts.
nudge() { local m="host:emulator:$((CONSOLE + 1))"; (exec 3<>"/dev/tcp/127.0.0.1/$ADB_PORT" && printf '%04x%s' ${#m} "$m" >&3 && timeout 2 head -c 4 <&3) >/dev/null 2>&1; }
# Connects to the starter and prints what it says: that starts the emulator's service if it is down and
# marks it used. Nothing printed: no starter, or a tunnel whose desktop has stopped answering.
poke() { (exec 2>/dev/null 3<>"/dev/tcp/127.0.0.1/$STARTER" 9>&- && timeout 5 cat <&3); }

# Holder file: "<until epoch>\t<who>". Taking the screen waits while another holder's lease runs.
take_screen() {
  mkdir -p "$dir" && exec 9<>"$lock" || { say "no lock folder at $dir"; exit 1; }
  local until name told=-60 since=$SECONDS
  while :; do
    if ! flock -n 9; then
      [ $((SECONDS - told)) -lt 60 ] || { say "waiting for the screen: $(cut -f2 "$holder" 2>/dev/null) has a step running"; told=$SECONDS; }
      flock 9
    fi
    IFS=$'\t' read -r until name 2>/dev/null <"$holder" || until=0
    if [ -z "${name:-}" ] || [ "$name" = "$who" ] || [ "${until:-0}" -le "$(date +%s)" ]; then break; fi
    flock -u 9
    [ $((SECONDS - told)) -lt 60 ] || { say "waiting for the screen: $name has it (for up to $((until - $(date +%s)))s more, longer if it keeps using it); waited $(((SECONDS - since) / 60)) min"; told=$SECONDS; }
    sleep 2
  done
  printf '%s\t%s\n' "$(($(date +%s) + LEASE))" "$who" >"$holder"
  touch "$used"
}
# After a step: the lease runs from now, and the flock goes when the process exits.
keep_screen() { printf '%s\t%s\n' "$(($(date +%s) + LEASE))" "$who" >"$holder"; touch "$used"; (poke >/dev/null 9>&- &); }

# A console step's arguments, checked on both sides: nothing but these words ever reaches the console, and
# a line break or other control character in the text would start a console command of its own.
# Fixed messages only: serve answers with them, and what it read must never go back to a turn.
check_sms() {
  local LC_ALL=C.UTF-8
  [[ $1 =~ ^\+?[0-9]{1,20}$ ]] || { echo "the sender must be digits with an optional leading +, at most 20"; return 1; }
  [ -n "$2" ] || { echo "the text is empty"; return 1; }
  [ "${#2}" -le $SMS_MAX ] || { echo "the text is over $SMS_MAX characters"; return 1; }
  [[ $2 != *[[:cntrl:]]* ]] || { echo "the text has a line break or another control character"; return 1; }
}

# Turn side: hand a console step to serve and print its answer. Arguments: the step's words.
console_step() {
  local id="$$.$RANDOM$RANDOM" t0=$SECONDS reply tmp
  local req="$dir/android.req.$id" out="$dir/android.out.$id"
  tmp=$(mktemp "$dir/android.tmp.XXXXXX") && printf '%s\n' "$@" >"$tmp" && mv -f "$tmp" "$req" || { say "can't write to $dir"; return 1; }
  until [ -e "$out" ]; do
    if [ $((SECONDS - t0)) -ge 20 ]; then
      rm -f "$req"
      say "the emulator's service didn't answer in 20s; it may still run code from before $1 existed: citadel-android down, then try again"
      return 1
    fi
    sleep 0.2
  done
  reply=$(cat "$out"); rm -f "$out"
  [ "$reply" = OK ] || { say "$reply"; return 1; }
}

# Host side (serve): one console command after auth. Prints OK or the console's KO line; never the token.
console() {
  local token line
  read_ok() {
    while IFS= read -r -t 10 line <&4; do
      line=${line%$'\r'}
      case $line in OK) return 0 ;; KO*) echo "$line"; return 1 ;; esac
    done
    echo "KO: no answer from the emulator console"; return 1
  }
  token=$(cat "$HOME/.emulator_console_auth_token" 2>/dev/null)
  exec 4<>"/dev/tcp/127.0.0.1/$CONSOLE_PORT" 2>/dev/null || { echo "KO: the emulator console isn't listening"; return 1; }
  if read_ok && { [ -z "$token" ] || { printf 'auth %s\r\n' "$token" >&4 && read_ok; }; } && printf '%s\r\n' "$1" >&4 && read_ok; then
    echo OK
  fi
  printf 'quit\r\n' >&4 2>/dev/null
  exec 4>&-
}

# Host side (serve): answer the turns' request files. Only known steps, checked again here, since anything
# running as this account can write a request. serve reads files turns can't, so a request that is a link
# (to the console token, say) or a hard link is refused, judged by what was opened rather than by the name,
# and answers are fixed words that never repeat what was read.
relay() {
  local f id verb from text reply ans real n=0
  real=$(readlink -f "$dir")
  for f in "$dir"/android.req.*; do
    [ -e "$f" ] || [ -L "$f" ] || continue
    id=${f##*/android.req.} reply="KO: refused: a request must be a plain file"
    # <> doesn't block on a FIFO swapped in after the -f check.
    if [ -f "$f" ] && [ ! -L "$f" ] && { exec 5<>"$f"; } 2>/dev/null; then
      if [ "$(readlink /proc/self/fd/5)" = "$real/android.req.$id" ] && [ "$(stat -L -c %F:%h /proc/self/fd/5)" = 'regular file:1' ]; then
        { IFS= read -r verb; IFS= read -r from; IFS= read -r text; } <&5
        case $verb in
          sms) reply=$(check_sms "$from" "$text" && console "sms send $from $text") ;;
          *) reply="KO: unknown step" ;;
        esac
        [ "${reply:0:2}" = OK ] || [ "${reply:0:2}" = KO ] || reply="KO: ${reply:-no answer}"
      fi
      exec 5>&-
    fi
    rm -f "$f"
    # mktemp makes a new file, and mv replaces a planted link rather than writing through it.
    ans=$(mktemp "$dir/android.ans.XXXXXX") && printf '%s\n' "$reply" >"$ans" && mv -f "$ans" "$dir/android.out.$id"
    n=1
  done
  # Answers nobody collected (a caller that gave up) go after a few minutes.
  [ $n = 0 ] || find "$dir" -maxdepth 1 \( -name 'android.out.*' -o -name 'android.ans.*' -o -name 'android.tmp.*' \) -mmin +5 -delete 2>/dev/null
  return 0
}

up() {
  local reply t0=$SECONDS poked=$SECONDS
  reply=$(poke)
  booted && return 0
  if [ -z "$reply" ]; then
    say "the emulator's desktop isn't connected (asleep, restarting, or Cara isn't logged on there). It comes back by itself when the PC does; nothing here needs fixing. Until then there is no emulator: say so rather than wait."
    exit 1
  fi
  say "starting the emulator ($AVD); a quick boot takes seconds, a cold one a few minutes"
  say "$reply"
  until booted; do
    nudge
    # A service still winding down from a `down` or the idle stop ignores the start: ask again once it's gone.
    if [ $((SECONDS - poked)) -ge 15 ] && ! { port_open "$ADB_PORT" && ask get-state >/dev/null 2>&1; }; then
      poke >/dev/null
      poked=$SECONDS
    fi
    if [ $((SECONDS - t0)) -ge $BOOT_WAIT ]; then
      say "not booted after ${BOOT_WAIT}s; ask your Taskmaster: the emulator's log is on Cara's desktop (deploy/desktop/android/README.md, \"When it doesn't work\")"
      exit 1
    fi
    sleep 2
  done
  # Once per boot, cheap: keep the screen on and unlocked, and skip Chrome's first-run pages so `open` lands on the URL.
  adb shell 'svc power stayon true; settings put system screen_off_timeout 2147483647; wm dismiss-keyguard' >/dev/null 2>&1
  adb shell 'echo "_ --disable-fre --no-default-browser-check --no-first-run" > /data/local/tmp/chrome-command-line' >/dev/null 2>&1
  adb shell am set-debug-app --persistent com.android.chrome >/dev/null 2>&1
  adb shell pm grant com.android.chrome android.permission.POST_NOTIFICATIONS >/dev/null 2>&1
  say "up after $((SECONDS - t0))s ($SERIAL)"
}

# perigee's side when the emulator is on the desktop (citadel-android-adb.service): the adb server every turn
# talks to, and the console steps, which reach the console through the tunnel with the token kept here.
adb_serve() {
  mkdir -p "$dir"
  "$ADB" start-server 9>&-
  while port_open "$ADB_PORT"; do sleep 1; relay; done
  say "the adb server is gone"; exit 1
}

# The emulator's service, wherever it runs: the emulator, stopped after IDLE seconds unused. On the desktop
# (CITADEL_ANDROID_ROLE=desktop) there is no adb server, and "used" is the starter's mark, not a step's
# lock: shortcut: a single step that runs longer than IDLE can meet the idle stop, give the starter a
# "busy" word if one ever does.
serve() {
  local emu="$SDK/emulator/emulator" pid far=
  [ "${CITADEL_ANDROID_ROLE:-}" != desktop ] || far=1
  mkdir -p "$dir" && touch "$used"
  [ -n "$far" ] || "$ADB" start-server
  # Saving the quick-boot snapshot writes ~2.6 GB and took 17s here; the emulator's default 20s cut one short.
  export ANDROID_EMULATOR_WAIT_TIME_BEFORE_KILL=90
  "$emu" -avd "$AVD" -port "$CONSOLE" -no-window -no-audio -no-boot-anim -no-metrics \
    -gpu swiftshader_indirect -feature -Vulkan -memory "${CITADEL_ANDROID_MEMORY:-2048}" -cores "${CITADEL_ANDROID_CORES:-2}" &
  pid=$!
  # `adb emu kill` shuts it down cleanly, which saves the quick-boot snapshot; plain signals are the fallback.
  stop() {
    if [ -n "$far" ]; then console kill >/dev/null 2>&1; else adb emu kill >/dev/null 2>&1; fi
    for _ in $(seq 100); do kill -0 "$pid" 2>/dev/null || return 0; sleep 1; done
    kill "$pid" 2>/dev/null
  }
  trap 'stop; exit 0' TERM INT
  local nap
  idle() { echo $(($(date +%s) - $(stat -c %Y "$used" 2>/dev/null || echo 0))); }
  while kill -0 "$pid" 2>/dev/null; do
    # Wake on the emulator's exit too, so the service ends with it and a new `up` can start it again.
    # Once a second, so a console step's request gets its answer quickly.
    sleep 1 & nap=$!
    wait -n "$pid" "$nap"
    kill "$nap" 2>/dev/null
    relay
    [ "$(idle)" -ge "$IDLE" ] || continue
    # No step is running (a step holds the flock), and none starts until the stop and its snapshot save are
    # done: a caller arriving meanwhile waits on the lock, then its `up` starts the service again.
    exec 9<>"$lock"
    if flock -n 9 && [ "$(idle)" -ge "$IDLE" ]; then
      echo "unused for $(idle)s; stopping"
      stop
      exit 0
    fi
    exec 9>&-
  done
  wait "$pid"
}

down() {
  if ! port_open "$ADB_PORT" || ! ask get-state >/dev/null 2>&1; then say "not running"; return 0; fi
  say "stopping the emulator (saving its quick-boot snapshot)"
  adb emu kill >/dev/null 2>&1
  local t0=$SECONDS
  # Once the service ends its adb server goes too: asking again would start a stray one here.
  while port_open "$ADB_PORT" && ask get-state >/dev/null 2>&1 && [ $((SECONDS - t0)) -lt 100 ]; do sleep 1; done
  : >"$holder"
}

cmd=${1:-}
[ $# -gt 0 ] && shift
case "$cmd" in
  serve) serve ;;
  adb-serve) adb_serve ;;
  up) take_screen; up; keep_screen ;;
  install)
    [ $# -eq 1 ] && [ -f "$1" ] || { say "usage: citadel-android install <file.apk>"; exit 2; }
    take_screen; up; need_server
    out=$(adb install -r -t "$1" 2>&1); s=$?; printf '%s\n' "$out"
    case "$out" in *INSTALL_FAILED_UPDATE_INCOMPATIBLE*) say "the installed copy was signed with another key. Debug builds should sign with the app's committed debug keystore. Uninstall it only if it is yours: someone else's build and its data go with it." ;; esac
    keep_screen; exit $s ;;
  open)
    [ $# -eq 1 ] || { say "usage: citadel-android open <url>"; exit 2; }
    take_screen; up; need_server; adb shell am start -W -a android.intent.action.VIEW --es com.android.browser.application_id citadel -d "'${1//\'/}'" >/dev/null; s=$?; keep_screen; exit $s ;;
  shot)
    [ $# -eq 1 ] || { say "usage: citadel-android shot <file.png>"; exit 2; }
    take_screen; need_server
    # shot is the one step that doesn't run `up` first, so it carries its own limit for a desktop that went to sleep.
    timeout 30 "$ADB" -s "$SERIAL" exec-out screencap -p >"$1" 9>&- && [ -s "$1" ]; s=$?
    keep_screen
    [ $s = 0 ] && say "saved $1" || say "screenshot failed"
    exit $s ;;
  offline)
    case "${1:-}" in on) m=enable ;; off) m=disable ;; *) say "usage: citadel-android offline on|off"; exit 2 ;; esac
    take_screen; up; need_server; adb shell cmd connectivity airplane-mode "$m"; s=$?; keep_screen; exit $s ;;
  sms)
    [ $# -eq 2 ] || { say "usage: citadel-android sms <from> <text>   (an incoming text from <from>)"; exit 2; }
    why=$(check_sms "$1" "$2") || { say "$why"; exit 2; }
    take_screen; up; need_server; console_step sms "$1" "$2"; s=$?; keep_screen
    [ $s = 0 ] && say "sent a text from $1 to the emulator"
    exit $s ;;
  down) take_screen; down ;;
  *)
    say "usage: citadel-android up | install <apk> | open <url> | shot <file.png> | offline on|off | sms <from> <text> | down"
    exit 2 ;;
esac
