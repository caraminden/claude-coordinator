#!/usr/bin/env bash
# Run a heavy build or a full test suite in one of a few host-wide slots (#325):
#   citadel-heavy <command> [args...]
# Every minion of every scheme shares the slots, in every person's container and on the host, so a
# burst of minions builds a few at a time instead of all at once. The rest wait in line and say for whom.
# A slot is a flock(1) lock on a file in $CITADEL_HEAVY_DIR (turns get Citadel's projects folder, which
# every container mounts at the same path). The kernel drops a lock when its holder exits or dies, so
# no slot is ever left stale. How many slots: the first number in $CITADEL_HEAVY_DIR/slots (edit it to
# tune; the next job in line reads it; # starts a comment), else $CITADEL_HEAVY_SLOTS, else 2. Keep the
# live file's comments free of digits: copies pinned in turns from before #503 read every digit in it.
#
# Box load (#503): a free slot isn't enough on its own. The job next in line also reads the host's CPU
# pressure, /proc/pressure/cpu's "some avg60": the share of the last minute in which some task was
# waiting for a CPU (containers see the host's). At 50% or more the CPUs are already full, so it waits
# even with a slot free. After waiting 5 min on load it takes the free slot anyway, so nothing waits
# forever: under sustained load, one more heavy job starts every 5 min at most. Without the pressure file
# (no PSI) it goes by slots alone. CITADEL_HEAVY_MAX_PRESSURE, CITADEL_HEAVY_LOAD_WAIT (seconds) and
# CITADEL_HEAVY_PRESSURE (the file) override these, and CITADEL_HEAVY_POLL the seconds between looks, for tests.
#
# RAISING THE SLOT COUNT UNDER LOAD MAKES SUITES SLOWER, NOT FASTER. On 2026-11-10 the slots went from 3
# to 6 to push a stuck landing through: six suites ran at once, the load reached ~100 on 16 cores,
# every suite slowed down and timing-sensitive tests went red. When jobs queue on a busy box, wait.
#
# History (#596): when a job ends it appends one tab-separated line to $CITADEL_HEAVY_DIR/history: when it
# started (ISO), who, what, where it ran (here, on:<machine> or ci:<owner>/<repo>; #2109), the wait and the run in
# seconds, the exit status, the CPU pressure it was admitted at (- without one), its CPU seconds (- unmeasured) and what
# it waited on last (here: none, line, slots, load, memory, first, forced or light; on a machine: none, room or offline
# there, or what it waited on in perigee's line first; on CI: none, turn for the repo's CI turn, or runner). It answers
# how long jobs wait, on what and where, per scheme and command, which nothing else keeps. One short append per line, so jobs in several
# containers can't interleave; a failed write is ignored. Past about 5 MB the job that notices keeps the newest
# half, by a rename. Nested calls and runs without a lock folder write nothing.
#
# Priority (#885): CITADEL_HEAVY_PRIORITY=1 (a contraption's deploy build, which src/app-services.ts holds in one slot
# for all its steps) goes ahead of every job waiting in the plain line, and skips the load wait: it is seconds of
# niced work someone is waiting on, and paid 15-20 min a step behind minions' suites. Priority jobs keep a line of
# their own (queue.first); its head says so in $CITADEL_HEAVY_DIR/first, freshened at every look, and the plain
# line's jobs leave free slots alone while that file is fresh. CITADEL_HEAVY_WHAT names the job in place of the command.
#
# Exits with the command's status. Nested calls (a wrapped script that wraps its own step) run straight
# away in the outer call's slot. When the lock folder or flock is missing, it warns and runs unlocked.
#
# On CI (#1160, Josh 2026-11-20: "the goal is to NOT hammer perigee... If I run out of compute, things slow down, but
# perigee is fine and nothing breaks, we just ship less"): in a repo with .github/workflows/citadel-heavy.yml, the job
# runs on that scheme's CI runners instead (tools/heavy-ci.ts beside this file: the working copy as it is, its output
# and status back here). One job per repo at a time (CITADEL_HEAVY_CI_SLOTS), so a scheme with two runners keeps one
# for its lands; the rest wait here in ci-<owner>-<repo>-<n>, which costs perigee nothing. When nothing ran there
# (no workflow, no runner took it in 10 min, GitHub refused) it says why and runs here as below. Its history line has
# reason ci:<owner>/<repo>. `citadel-heavy --here <command...>` (or CITADEL_HEAVY_HERE=1) keeps a job on perigee:
# one that reads data only perigee has or uses its Android emulator (a job that runs Claude is light: below). Priority
# jobs always run here.
#
# Four cores (#1928, Josh 2026-11-25, "Limit it to 4 cores"): a slot limits how many jobs start, not the CPU each takes, and
# Chrome raises its own priority past our nice 19 (a burn-in's 4 browsers took the box). So a plain job's command runs under
# taskset on CITADEL_HEAVY_CPUS (4; 0 = off) of the CPUs it may use, and everything it starts inherits that whatever nice it
# sets. The set is fixed, the lowest-numbered CPUs, each with its hyperthread sibling (read from /sys) so two jobs never split a
# core; jobs at once share the same set on purpose. Not pinned: priority jobs, light jobs (so Claude-bound ones), anything on CI
# (RUNNER_TEMP, GITHUB_ACTIONS), nested calls (they inherit the outer job's set), and a box or container with that many CPUs or
# fewer. No taskset, or one that refuses the set (CITADEL_HEAVY_TASKSET names the program, for tests): it says so and runs unpinned.
# Perigee's small slot (#1160, Josh: "One small slot here"): plain jobs here use at most CITADEL_HEAVY_PLAIN_SLOTS (1)
# of the slots, at nice 19 and idle disk priority, so minions never feel them; the other slots are for priority jobs
# (deploy and APK builds), which take them from the top down.
#
# Ships go first (#1902): while a ship is in line on that PC, a CI job waits here up to 5 minutes, then Citadel keeps it
# (its snapshot and command), starts it when the line is empty and wakes the minion with the result: exit 75, "handed over".
#
# Long jobs (#1363): `citadel-heavy --long <command...>` doesn't wait. It snapshots the working copy for the scheme's CI,
# queues the job and prints its id at once (tools/heavy-ci.ts --long). The server starts it at night, from 2am until the
# job hours of the PC that runs the repo's runners end, and wakes the minion when it ends.
#
# Only heavy work waits (#1629, Cara 2026-11-22: "Heavy slot should be for tasks that will be spending CPU for the vast
# majority of their runtime AND will run for at least several minutes"). Before the line or CI, each job is judged light
# or heavy, and a light one runs here at once: no slot, no CI, no load or memory wait, still at nice 19.
# - Claude-bound jobs are always light (prompt-eval, skill-trigger-eval, citadel-replay, review-escapes, claude itself):
#   Cara: "Our goal is to be able to run many Claudes as efficiently as possible, its the actual heavy work we want to
#   offload". No limit of their own.
# - Otherwise by the job's own past runs: history lines of the same scheme (who up to " #" or " (") and the same command
#   (its first 8 words past env, nice, timeout, time and `mise exec ... --`, paths cut to their last part, so a filtered
#   `cargo test -p x some_test` is not the whole crate's run), the newest 5.
#   Heavy when their median run is CITADEL_HEAVY_MIN_RUN s (180) or more AND their median CPU time is at least
#   CITADEL_HEAVY_MIN_CPU % (75, "the vast majority") of the run, counted over all its cores. Lines from before the
#   CPU column count by run time alone: long is heavy.
# - A job with no past runs is light unless the caller guesses heavy: `citadel-heavy --heavy <command...>` (or
#   CITADEL_HEAVY_GUESS=heavy), Cara: "Let the minion make an intelligent guess for unknowns". Its own runs decide after.
# Priority jobs skip the judgment, and CITADEL_HEAVY_JUDGE=0 turns it off. A light job's nested citadel-heavy calls are judged on their own.
# The history line's ninth column is the command's CPU time in seconds (its waited-for children, from /proc/$$/stat), so
# old 8-column lines still parse; a job that ran elsewhere writes - there. The tenth, last, is what it waited on.
set -uo pipefail

say() { echo "citadel-heavy: $*" >&2; }
# The CPU seconds (user + system, in ticks of 1/100 s) of this shell's waited-for children: $$ is this shell's pid in a subshell too.
cpu_ticks() { local s f; read -r s </proc/$$/stat 2>/dev/null || { echo 0; return; }; read -ra f <<<"${s##*) }"; echo $((${f[13]:-0} + ${f[14]:-0})); }
# The clock for the history line's wait and run: microseconds, so a difference is the time that passed. Two reads of
# $SECONDS count the second ticks crossed between them, and a job that took a free slot at once said it waited 1 s
# whenever its setup ran across a tick (#1367). $SECONDS where bash is older than 5.0, which has no EPOCHREALTIME.
us() { local t=${EPOCHREALTIME:-}; t=${t//[!0-9]/}; echo "${t:-${SECONDS}000000}"; }
here=${CITADEL_HEAVY_HERE:-}
guess=${CITADEL_HEAVY_GUESS:-light}
orig=("$@") back=()
usage() {
  cat <<'U'
usage: citadel-heavy [--here] [--heavy] [--back <path>]... <command> [args...]
       citadel-heavy --long <command> [args...]
  --here   run the command on this machine, never on the scheme's CI or another machine.
  --back <path>  a file or folder the command makes that you need here (an APK, a binary), from this folder
           (it must be inside the working copy); repeat it for more. The job then runs on a machine with the Builds role when one has room, and
           these come back into your working copy.
  --heavy  guess a command with no past runs is heavy (it is light by default); its own runs decide after.
  --long   run the command on the scheme's CI only (not with --here); a long job.
  -h, --help  print this usage. Options go before the command: after it they belong to the command.
U
}
# Help is read before anything runs or waits, a nested call (CITADEL_HEAVY_HELD) included: it never starts a job (#1960).
# Options are read up to the command; one citadel-heavy doesn't know is refused, not run as a command.
skip=
for a in "$@"; do
  if [ -n "$skip" ]; then skip=; continue; fi
  case $a in
    -h|--help) usage; exit 0 ;;
    --here|--heavy|--long) ;;
    --back) skip=1 ;;
    -*) say "unknown option $a"; usage >&2; exit 2 ;;
    *) break ;;
  esac
done
while :; do
  case ${1:-} in
    --here) here=1; shift ;;
    --heavy) guess=heavy; shift ;;
    --back) [ $# -ge 2 ] || { say "--back takes a path"; exit 2; }; back+=("$2"); shift 2 ;;
    *) break ;;
  esac
done
if [ "${1:-}" = --long ]; then
  [ -z "$here" ] || { say "a long job runs on the scheme's CI only, so --long and --here (or CITADEL_HEAVY_HERE) don't go together"; exit 2; }
  shift
  case ${1:-} in --here|--heavy|--long|--back) say "--long takes the command next, not $1"; exit 2 ;; esac
  exec "$(command -v citadel-node || echo node)" "$(dirname "$0")/heavy-ci.ts" --long "$@"
fi
[ $# -gt 0 ] || { usage >&2; exit 2; }
[ -z "${CITADEL_HEAVY_HELD:-}" ] || exec "$@"

dir=${CITADEL_HEAVY_DIR:-$HOME/.local/share/claude-coordinator/projects/.heavy}
who=${CITADEL_HEAVY_WHO:-$(id -un 2>/dev/null || echo someone)}
what=${CITADEL_HEAVY_WHAT:-$*}
who=${who//[$'\t\n']/ } what=${what//[$'\t\n']/ } # one line each: the slot and wait files are read a line at a time (#1863)
first=${CITADEL_HEAVY_PRIORITY:+1}
[ ${#what} -le 100 ] || what="${what:0:97}..."
poll=${CITADEL_HEAVY_POLL:-2}

# The CPUs a plain job is pinned to, as a taskset -c list; prints nothing when it should run unpinned (#1928, the header).
pin_cpus() {
  local want=${CITADEL_HEAVY_CPUS:-4} ts=${CITADEL_HEAVY_TASKSET:-taskset} out part a b c s i
  local -a allowed=() pick=() sib
  declare -A ok=() have=()
  [ "$want" -gt 0 ] 2>/dev/null || return 0
  [ -z "${RUNNER_TEMP:-}${GITHUB_ACTIONS:-}" ] || return 0
  command -v "$ts" >/dev/null 2>&1 || { say "no taskset, so this runs on every CPU"; return 0; }
  out=$("$ts" -pc $$ 2>/dev/null) && out=${out##*: } || { say "taskset can't read the CPUs this may use, so it runs on every CPU"; return 0; }
  for part in ${out//,/ }; do
    a=${part%-*} b=${part#*-}
    for ((c = a; c <= b; c++)); do allowed+=("$c"); ok[$c]=1; done
  done
  [ ${#allowed[@]} -gt "$want" ] || return 0
  for c in "${allowed[@]}"; do
    [ ${#pick[@]} -lt "$want" ] || break
    [ -z "${have[$c]:-}" ] || continue
    s=$c
    read -r s <"/sys/devices/system/cpu/cpu$c/topology/thread_siblings_list" 2>/dev/null || s=$c
    for part in ${s//,/ }; do
      a=${part%-*} b=${part#*-}
      for ((i = a; i <= b; i++)); do
        [ -n "${ok[$i]:-}" ] && [ -z "${have[$i]:-}" ] && [ ${#pick[@]} -lt "$want" ] && { pick+=("$i"); have[$i]=1; }
      done
    done
  done
  out=$(IFS=,; echo "${pick[*]}")
  "$ts" -c "$out" true 2>/dev/null || { say "taskset refused CPUs $out, so this runs on every CPU"; return 0; }
  echo "$out"
}
# Light or heavy (#1629, the header): prints "light <why>" or "heavy <why>".
judge() {
  local claude='(^|[ /])(prompt-eval|skill-trigger-eval|skill-evals|citadel-replay|review-escapes|claude)([ /.]|$)'
  if [[ " $* $what " =~ $claude ]]; then echo "light it runs Claude turns, which wait on Claude, not the CPU"; return; fi
  local h=$dir/history
  [ -f "$h" ] || h=/dev/null # a fifo or a missing file would hang or fail the read
  awk -F'\t' -v who="$who" -v what="$what" -v guess="$guess" -v min_run="${CITADEL_HEAVY_MIN_RUN:-180}" -v min_cpu="${CITADEL_HEAVY_MIN_CPU:-75}" '
    function scheme(w) { sub(/ [#(].*/, "", w); return w }
    function key(s,   a, n, i, j, k, out, w) {
      n = split(s, a, / +/)
      for (i = 1; i <= n; i++) {
        w = a[i]
        if (w ~ /^[A-Za-z_][A-Za-z0-9_]*=/ || w == "env" || w == "time" || w == "command" || w == "--") continue
        if (w == "nice") { if (a[i + 1] == "-n") i += 2; else if (a[i + 1] ~ /^-/) i++; continue }
        if (w == "timeout") { while (a[i + 1] ~ /^-/) { i++; if (a[i] ~ /^-[ks]$/) i++ } i++; continue }
        if ((w == "mise" || w ~ /\/mise$/) && (a[i + 1] == "exec" || a[i + 1] == "x")) {
          for (j = i + 2; j <= n && a[j] != "--"; j++);
          i = j <= n ? j : i + 1
          continue
        }
        sub(/.*\//, "", w); sub(/\.ts$/, "", w)
        out = out (k++ ? " " : "") w
        if (k == 8) break
      }
      return out
    }
    function median(v, c,   i, j, t) {
      for (i = 2; i <= c; i++) for (j = i; j > 1 && v[j - 1] > v[j]; j--) { t = v[j]; v[j] = v[j - 1]; v[j - 1] = t }
      return c % 2 ? v[(c + 1) / 2] : (v[c / 2] + v[c / 2 + 1]) / 2
    }
    BEGIN { mine = scheme(who) "\t" key(what) }
    # A job that failed at once says nothing about how long it takes (#1863).
    $7 != 0 && $6 < min_run { next }
    $6 ~ /^[0-9]+$/ && scheme($2) "\t" key($3) == mine { seen++; run[seen % 5] = $6 + 0; cpu[seen % 5] = $9 }
    END {
      if (!seen) { print guess, "no past runs of it" (guess == "heavy" ? "; the caller guessed heavy" : ""); exit }
      for (i in run) { r[++c] = run[i]; if (cpu[i] ~ /^[0-9]+$/ && run[i] > 0) s[++m] = 100 * cpu[i] / run[i] }
      mr = median(r, c)
      if (mr < min_run) { printf "light its last %d run(s) took %d s (median)\n", c, mr; exit }
      if (!m) { printf "heavy its last %d run(s) took %d s (median); CPU not measured yet\n", c, mr; exit }
      ms = median(s, m)
      printf "%s its last %d run(s) took %d s (median), CPU busy %d%% of it\n", (ms >= min_cpu) ? "heavy" : "light", c, mr, ms
    }' "$h" 2>/dev/null
}
# Past about 5 MB the job that notices keeps the newest half of the history, whole lines only.
trim_history() {
  local h=$dir/history max=${CITADEL_HEAVY_HISTORY_MAX:-5000000} cut
  [ "$(stat -c %s "$h" 2>/dev/null || echo 0)" -gt "$max" ] || return 0
  # tail -n +2 drops the line the byte cut lands in. shortcut: lines another job appends during the copy are lost, a few at most once per 2.5 MB.
  cut="$h.$$-$RANDOM"
  { tail -c "$((max / 2))" "$h" | tail -n +2 >"$cut" && mv -f "$cut" "$h"; } 2>/dev/null || rm -f "$cut" 2>/dev/null
}
# A light job runs here and now, at nice 19, and writes its own history line. CITADEL_HEAVY_JUDGE=0 sends every job to the
# line, as before #1629 (the line's own tests; an off switch).
if [ -z "$first" ] && [ "${CITADEL_HEAVY_JUDGE:-}" != 0 ]; then
  read -r weight why < <(judge "$@")
  if [ "$weight" = light ]; then
    say "runs at once, without a heavy slot: $why"
    started=$(date +%s) t1=$(us) c0=$(cpu_ticks)
    nicer=(nice -n 19)
    ! command -v ionice >/dev/null || nicer+=(ionice -c 3)
    "${nicer[@]}" "$@"
    status=$?
    { mkdir -p "$dir" && printf '%s\t%s\t%s\there\t0\t%s\t%s\t-\t%s\tlight\n' "$(date -d "@$started" +%FT%T%z)" "${who//[$'\t\n']/ }" "${what//[$'\t\n']/ }" "$((($(us) - t1) / 1000000))" "$status" "$((($(cpu_ticks) - c0) / 100))" >>"$dir/history"; } 2>/dev/null
    trim_history
    exit "$status"
  fi
fi

ci=("$(command -v citadel-node || echo node)" "$(dirname "$0")/heavy-ci.ts")
hasci= slug=
[ -n "$here$first" ] || ! slug=$("${ci[@]}" --repo) || hasci=1
# Another machine (H2, Josh 2026-11-26: "By what comes back", "Perigee is the last machine"): a job with files to bring
# back, or in a scheme with no CI, goes to a machine whose Builds role is lent to the scheme and has room
# (tools/heavy-builds.ts); with none it waits in perigee's line, asking again each minute. --here and priority jobs never go.
builds=("${ci[0]}" "$(dirname "$0")/heavy-builds.ts")
backargs=()
for b in "${back[@]}"; do backargs+=(--back "$b"); done
elsewhere=
if [ -z "$here$first${CITADEL_HEAVY_NO_ELSEWHERE:-}" ] && [ -n "${COORDINATOR_API:-}" ] && [ -f "${builds[1]}" ] && { [ ${#back[@]} -gt 0 ] || [ -z "$hasci" ]; }; then elsewhere=1; fi
# Runs it there and exits with its status; returns only when nothing took it, for perigee's line.
run_elsewhere() {
  local fell ran on t1 all took status m held waited
  started=$(date +%s) t1=$(us) fell=$(mktemp) ran=$(mktemp) on=$(mktemp) held=$(mktemp)
  CITADEL_HEAVY_FALLBACK_FILE=$fell CITADEL_HEAVY_RAN_FILE=$ran CITADEL_HEAVY_ON_FILE=$on CITADEL_HEAVY_WAITED_FILE=$held "${builds[@]}" "${backargs[@]}" -- "$@"
  status=$?
  [ -s "$fell" ] && status=fallback
  all=$((($(us) - t1) / 1000000)) took=$(cat "$ran" 2>/dev/null) m=$(head -c 100 "$on" 2>/dev/null | tr -d '\t\n')
  [[ $took =~ ^[0-9]{1,7}$ ]] && [ "$took" -le "$all" ] || took=$all
  # What held it on the machine, else what it waited on in perigee's line before it left it.
  waited=$(head -c 20 "$held" 2>/dev/null | tr -d '\t\n')
  rm -f "$fell" "$ran" "$on" "$held"
  [ "$status" != fallback ] || return 0
  # One that left perigee's line for the machine waited there too, from $lined.
  { mkdir -p "$dir" && printf '%s\t%s\t%s\ton:%s\t%s\t%s\t%s\t-\t-\t%s\n' "$(date -d "@$started" +%FT%T%z)" "${who//[$'\t\n']/ }" "${what//[$'\t\n']/ }" "${m:-?}" "$(((t1 - ${lined:-$t1}) / 1000000 + all - took))" "$took" "$status" "${waited:-${reason:-none}}" >>"$dir/history"; } 2>/dev/null
  exit "$status"
}
[ -z "$elsewhere" ] || run_elsewhere "$@"
# Back from the line each minute: a machine with room now takes it, and its place in the line goes to the next.
asked=$SECONDS
try_elsewhere() {
  [ -n "$elsewhere" ] && [ $((SECONDS - asked)) -ge "${CITADEL_HEAVY_REPLACE_S:-60}" ] || return 0
  asked=$SECONDS
  "${builds[@]}" --place-only -- "$@" || return 0
  say "a machine with the Builds role has room now, so this leaves perigee's line"
  [ -z "$marked" ] || rm -f "$dir/first"
  exec 7>&- 6>&-
  rm -f "$waitfile"
  lined=$t0
  run_elsewhere "$@"
  # It was taken before this one got there: back into the line, without asking again.
  CITADEL_HEAVY_NO_ELSEWHERE=1 exec "$0" "${orig[@]}"
}
if [ -n "$hasci" ] && [ ${#back[@]} -eq 0 ]; then
  started=$(date +%s) t0=$(us)
  # One job per repo on CI at a time: this waits for the repo's turn, then holds fd 5 while its job runs there.
  # shortcut: this wait writes no wait-* file, so Citadel shows the minion as running, not waiting; add one if people ask.
  key=${slug//\//-} n=${CITADEL_HEAVY_CI_SLOTS:-1} cislot= ciwaited=none
  if command -v flock >/dev/null && mkdir -p "$dir" 2>/dev/null; then
    told=-60
    until [ -n "$cislot" ]; do
      for ((i = 0; i < n; i++)); do
        exec 5<>"$dir/ci-$key-$i"
        if flock -n 5; then cislot=$i; break; fi
        exec 5>&-
      done
      [ -z "$cislot" ] || break
      ciwaited=turn
      if [ $((SECONDS - told)) -ge 60 ]; then
        say "$slug already has $n heavy job(s) on CI, so this waits here for its turn (it costs perigee nothing): $(cat "$dir/ci-$key-"*.who 2>/dev/null | head -n 3 | tr '\n' ';')"
        told=$SECONDS
      fi
      sleep "$poll"
    done
    printf '%s: %s (since %s, pid %s)\n' "$who" "$what" "$(date +%H:%M)" "$$" >"$dir/ci-$key-$cislot.who" 2>/dev/null
  fi
  t1=$(us) fell=$(mktemp) ran=$(mktemp) held=$(mktemp)
  CITADEL_HEAVY_FALLBACK_FILE=$fell CITADEL_HEAVY_RAN_FILE=$ran CITADEL_HEAVY_WAITED_FILE=$held "${ci[@]}" "$@"
  status=$?
  # The file, not the status, says nothing ran there: a command may exit 120 itself.
  [ -s "$fell" ] && status=fallback
  # What the runner worked on it, so the wait for a runner counts as waiting, not as how long the job takes (#1863).
  all=$((($(us) - t1) / 1000000)) took=$(cat "$ran" 2>/dev/null)
  [[ $took =~ ^[0-9]{1,7}$ ]] && [ "$took" -le "$all" ] || took=$all
  # The repo's CI turn, else what the client saw: a wait for a runner.
  [ "$ciwaited" != none ] || ciwaited=$(head -c 20 "$held" 2>/dev/null | tr -d '\t\n')
  rm -f "$fell" "$ran" "$held"
  [ -z "$cislot" ] || { rm -f "$dir/ci-$key-$cislot.who"; exec 5>&-; }
  if [ "$status" != fallback ]; then
    # 75: handed over to Citadel for ships, so it took no time here.
    [ "$status" = 75 ] || { printf '%s\t%s\t%s\tci:%s\t%s\t%s\t%s\t-\t-\t%s\n' "$(date -d "@$started" +%FT%T%z)" "${who//[$'\t\n']/ }" "${what//[$'\t\n']/ }" "$slug" "$(((t1 - t0) / 1000000 + all - took))" "$took" "$status" "${ciwaited:-none}" >>"$dir/history"; } 2>/dev/null
    exit "$status"
  fi
  # CI gave it back (no runner took it): a machine with the Builds role still comes before perigee's line.
  if [ -z "$here$first${CITADEL_HEAVY_NO_ELSEWHERE:-}" ] && [ -n "${COORDINATOR_API:-}" ] && [ -f "${builds[1]}" ]; then
    elsewhere=1
    run_elsewhere "$@"
  fi
fi

if ! command -v flock >/dev/null || ! mkdir -p "$dir" 2>/dev/null || ! : 2>/dev/null >>"$dir/queue"; then
  say "no lock folder at $dir (or no flock), so this runs without waiting for a slot"
  exec "$@"
fi
psi=${CITADEL_HEAVY_PRESSURE:-/proc/pressure/cpu}
max_pressure=${CITADEL_HEAVY_MAX_PRESSURE:-50}
load_wait=${CITADEL_HEAVY_LOAD_WAIT:-300}

slots() {
  local n
  n=$(sed 's/#.*//' "$dir/slots" 2>/dev/null | grep -o '[0-9][0-9]*' | head -n 1)
  n=${n:-${CITADEL_HEAVY_SLOTS:-2}}
  [[ $n =~ ^[0-9]{1,6}$ ]] && [ "$n" -ge 1 ] || n=1
  [ "$n" -le 64 ] || n=64 # a typo can't make it list a million slots
  echo "$n"
}

# Sets $pressure to the whole percent from the pressure file's "some avg60"; fails when there's none to read.
pressure=
read_pressure() {
  local line
  pressure=
  line=$(grep -m 1 '^some ' "$psi" 2>/dev/null) || return 1
  [[ $line =~ avg60=([0-9]+) ]] || return 1
  pressure=$((10#${BASH_REMATCH[1]}))
}
# "CPU pressure 63% over the last minute (it waits at 50%; load 41 on 16 cores)", for people reading the wait.
load_text() {
  local load cores
  load=$(cut -d ' ' -f 1 /proc/loadavg 2>/dev/null) && load=${load%%.*}
  cores=$(nproc 2>/dev/null)
  echo "CPU pressure $pressure% over the last minute (it waits at $max_pressure%${load:+; load $load on ${cores:-?} cores})"
}

# Memory room (#1340): the job's start waits while the room for heavy work (tools/mem-room: the smaller of MemAvailable
# and the heavy slice's headroom, or a container's own) is under what the job needs, CITADEL_HEAVY_MEM_NEED MB (default 2000: one suite). After
# CITADEL_HEAVY_MEM_WAIT s (default 300) it starts anyway and a test run sizes its own workers to the room it finds
# (citadel-test, npm test). Without a reading it never waits. Priority jobs skip this, as they skip the load wait.
mem_need=${CITADEL_HEAVY_MEM_NEED:-2000}
[[ $mem_need =~ ^[0-9]+$ ]] || mem_need=2000
mem_wait=${CITADEL_HEAVY_MEM_WAIT:-300}
# It also waits while the box's memory level (#1748, src/memory-ease.ts: $dir/memory-level, the level then why) says
# easing or tight; a file over 60 s old is a stopped server's, and counts as ok.
mem_room=
ease=
ease_level() {
  local f=${CITADEL_MEMORY_LEVEL:-$dir/memory-level} age lines
  ease=
  age=$(($(date +%s) - $(stat -c %Y "$f" 2>/dev/null || echo 0)))
  [ "$age" -le 60 ] || return 1
  mapfile -t lines <"$f" 2>/dev/null || return 1
  case ${lines[0]:-} in easing | tight) ease="${lines[0]}: ${lines[1]:-}"; return 0 ;; esac
  return 1
}
mem_short() {
  ease_level && return 0
  mem_room=$("$(dirname "$0")/mem-room" mb 2>/dev/null) && [[ $mem_room =~ ^[0-9]+$ ]] && [ "$mem_room" -lt "$mem_need" ]
}
mem_text() {
  if [ -n "$ease" ]; then echo "waiting for memory: Citadel is easing off ($ease)"; return; fi
  echo "waiting for memory: ${mem_room:-?} MB free for heavy work, needs $mem_need MB"
}

# The slots this job may use: plain jobs at most CITADEL_HEAVY_PLAIN_SLOTS of them.
plain=${CITADEL_HEAVY_PLAIN_SLOTS:-1}
[[ $plain =~ ^[0-9]{1,2}$ ]] && [ "$plain" -ge 1 ] || plain=1
limit() {
  local n
  n=$(slots)
  # Plain jobs share $plain slots; deploy and APK builds get one more of their own (#1160's plan).
  local cap=$plain
  [ -z "$first" ] || cap=$((plain + 1))
  [ "$n" -le "$cap" ] || n=$cap
  echo "$n"
}

# Try each slot once (priority jobs from the top, leaving the plain jobs' first ones free); on success fd 8 holds it and $slot says which.
slot=
take() {
  local i j n
  n=$(limit)
  for ((j = 0; j < n; j++)); do
    i=$j
    [ -z "$first" ] || i=$((n - 1 - j))
    exec 8<>"$dir/slot-$i"
    if flock -n 8; then slot=$i; return 0; fi
    exec 8>&-
  done
  return 1
}

# The admission decision: succeeds holding a slot it may run in; else $waiting says on what ("slots", "load" or "memory").
# The load clock starts the first time a free slot meets a busy box and keeps running from there; the memory clock is
# the same for a box with too little memory room (#1340).
waiting=
load_since=
mem_since=
forced=
admit() {
  if first_waits; then waiting=first; return 1; fi
  take || { waiting=slots; return 1; }
  [ -z "$first" ] || return 0
  if read_pressure && [ "$pressure" -ge "$max_pressure" ]; then
    load_since=${load_since:-$SECONDS}
    if [ $((SECONDS - load_since)) -ge "$load_wait" ]; then forced=1; return 0; fi
    exec 8>&-
    waiting=load
    return 1
  fi
  mem_short || return 0
  mem_since=${mem_since:-$SECONDS}
  if [ $((SECONDS - mem_since)) -ge "$mem_wait" ]; then forced=mem; return 0; fi
  exec 8>&-
  waiting=memory
  return 1
}

holders() {
  local i n f line
  n=$(limit)
  for ((i = 0; i < n; i++)); do
    f="$dir/slot-$i.who"
    line=$(cat "$f" 2>/dev/null) || line="(starting)"
    say "  slot $((i + 1)): ${line:-(starting)}"
  done
}

# "5 min", or seconds when under a minute (tests).
dur() { if [ "$1" -ge 60 ]; then echo "$(($1 / 60)) min"; else echo "$1 s"; fi; }

# Why it waits, said when that changes and again every minute.
tell() {
  local after=$1
  if [ "$waiting" = first ]; then
    say "${after}$(first_who) goes first (a deploy build, ahead of the line); waiting for it to take a slot ($who: $what)"
  elif [ "$waiting" = load ]; then
    say "${after}a heavy slot is free, but the box is busy: $(load_text). Waiting for it to ease, at most $(dur "$load_wait"), then it starts anyway ($who: $what). Raising the slot count would make every suite slower, not faster."
  elif [ "$waiting" = memory ]; then
    say "${after}a heavy slot is free, but $(mem_text). Waiting for room, at most $(dur "$mem_wait"), then it starts anyway with the workers that fit ($who: $what)."
  else
    say "${after}all heavy slots ($(limit)) are busy; waiting for one ($who: $what)"
    holders
  fi
}

# While it waits, wait-<pid>-<random> says who for, what, since when and on what (line, slots, load), so
# Citadel can show the minion's wait (#544; src/waits.ts reads it). Written by a rename, so nobody reads half
# of it, and freshened at least every 20 s: one older than a minute is a waiter killed past its trap. The
# random part: containers' pids can repeat each other's.
waitfile="$dir/wait-$$-$RANDOM$RANDOM"
# Those of waiters killed past their trap are never freshened again (#553 M13): ten minutes is thirty missed freshenings.
find "$dir" -maxdepth 1 -name 'wait-*' -mmin +10 -delete 2>/dev/null || true
reason=none # what it waited on last, for the history line
waiting_on() { reason=$1; printf '%s\n' "$who" "$what" "$started" "$1" >"$waitfile.tmp" 2>/dev/null && mv -f "$waitfile.tmp" "$waitfile" 2>/dev/null; }
started=$(date +%s)
marked= # it wrote $dir/first, as the priority line's head
trap 'rm -f "$waitfile" "$waitfile.tmp"; [ -z "$marked" ] || rm -f "$dir/first"' EXIT

# No wait is endless (#553): when no slot has changed hands for $max_wait s of waiting (a holder stopped or stuck),
# it gives up with status 75 and runs nothing. Slots that do change hands restart the clock, so a long line is fine.
max_wait=${CITADEL_HEAVY_MAX_WAIT:-3600}
hands() { cat "$dir"/slot-*.who 2>/dev/null; }
held=$(hands)
moved=$SECONDS
stuck() {
  local now
  now=$(hands)
  if [ "$now" != "$held" ]; then held=$now moved=$SECONDS; fi
  [ $((SECONDS - moved)) -ge "$max_wait" ] || return 0
  say "gave up: no heavy slot has changed hands in $(dur $((SECONDS - moved))) of waiting, so nothing ran ($who: $what). The holders below are stopped, stuck or running longer than that: check them by pid (wake or stop a stuck one), then run this again"
  holders
  exit 75
}

# The line: whoever holds the queue lock is next and polls for a free slot; the rest wait behind it. queue.who names
# it and is freshened at every look (#553): one stale for $head_stale s while the lock is held is a job stopped or
# frozen at the head, and the jobs behind go for the slots past it rather than wait on it in silence. Its age, not
# its pid: jobs in other containers share the line, and their pids mean nothing here. A head started by a copy from
# before this doesn't freshen the file, so it can be passed over while healthy: that costs it its turn, nothing else.
head_stale=${CITADEL_HEAVY_HEAD_STALE:-60}
headfile=$dir/queue.who
[ -z "$first" ] || headfile=$dir/first
next() { cat "$headfile" 2>/dev/null || echo "a job that doesn't say"; }
head_age() {
  local m
  m=$(stat -c %Y "$1" 2>/dev/null) || return 1 # none yet: nobody is passed over
  echo $(($(date +%s) - m))
}
# A priority job waits for a slot: a plain job leaves free slots to it. A marker its writer stopped freshening doesn't count.
first_waits() { [ -z "$first" ] && age=$(head_age "$dir/first") && [ "$age" -lt "$head_stale" ]; }
first_who() { local l; l=$(cat "$dir/first" 2>/dev/null); echo "${l%%: *}"; }
exec 7<>"$dir/queue${first:+.first}"
since=$SECONDS t0=$(us)
exec 6<>"$dir/queue.past"
past= told_past= got= # past: it is the one going past a stopped head; got: it holds a slot already, taken past a stopped head
if ! flock -n 7; then
  waiting_on line
  say "others are in line for a heavy slot first (next: $(next)); waiting ($who: $what)"
  holders
  told=$SECONDS
  until flock -w "$poll" 7; do
    touch "$waitfile" 2>/dev/null
    stuck
    try_elsewhere "$@"
    if age=$(head_age "$headfile") && [ "$age" -ge "$head_stale" ]; then
      [ -n "$told_past" ] || say "the job next in line ($(next)) has not moved for $age s (stopped or frozen), so this one goes past it ($who: $what)"
      told_past=1
      # One at a time past the head, as in the line itself: each would else run its own load clock and start together.
      if [ -n "$past" ] || flock -n 6; then
        past=1
        if admit; then got=1; break; fi
      fi
    fi
    if [ $((SECONDS - told)) -ge 60 ]; then
      say "still waiting after $(((SECONDS - since) / 60)) min, in line behind $(next) ($who: $what)"
      told=$SECONDS
    fi
  done
fi
[ -n "$got" ] || { printf '%s: %s (since %s)\n' "$who" "$what" "$(date +%H:%M)" >"$headfile" 2>/dev/null && marked=$first; }
if [ -z "$got" ] && ! admit; then
  waiting_on "$waiting"
  tell ""
  told=$SECONDS
  said=$waiting
  until admit; do
    sleep "$poll"
    touch "$headfile" 2>/dev/null
    stuck
    try_elsewhere "$@"
    if [ "$waiting" = "$said" ]; then touch "$waitfile" 2>/dev/null; else waiting_on "$waiting"; fi
    if [ "$waiting" != "$said" ] || [ $((SECONDS - told)) -ge 60 ]; then
      tell "still waiting after $(((SECONDS - since) / 60)) min: "
      told=$SECONDS
      said=$waiting
    fi
  done
fi
# The marker goes before the line's lock, so the next priority job's own isn't deleted.
[ -z "$marked" ] || rm -f "$dir/first"
marked=
exec 7>&- 6>&-
rm -f "$waitfile"
if [ "$forced" = mem ]; then say "memory is still short ($(mem_text)) after $(dur "$mem_wait") waiting, so this starts anyway in slot $((slot + 1)), with the workers that fit"
elif [ -n "$forced" ]; then say "the box is still busy ($(load_text)) after $(dur "$load_wait") waiting on it, so this starts anyway in slot $((slot + 1))"; fi
[ $((SECONDS - since)) -lt 2 ] || [ -n "$forced" ] || say "got slot $((slot + 1)) after $((SECONDS - since))s"

# A Node test suite run through tools/citadel-node keeps slot-N.progress up to date with its file counts (#545),
# which Citadel shows as the holder's wait; another command leaves it alone, and shows elapsed time only.
progress="$dir/slot-$slot.progress"
# What the command prints is also teed into slot-N.out, whose end Citadel shows under the minion's wait (#1681). Not on a
# terminal: stdout and stderr go through their own tees, which would turn a tty into a pipe (colour, progress bars).
# shortcut: no size cap (GNU head -c holds its output back, so it can't cap a live tee); the file is a run's whole output, truncated per run and removed when it ends. Cap it if a run ever prints GBs.
out="$dir/slot-$slot.out"
rm -f "$progress" "$progress.tmp" 2>/dev/null
: >"$out" 2>/dev/null || out=/dev/null
printf '%s: %s (since %s, pid %s)\n' "$who" "$what" "$(date +%H:%M)" "$$" >"$dir/slot-$slot.who" 2>/dev/null
trap 'rm -f "$dir/slot-$slot.who" "$waitfile" "$waitfile.tmp" "$progress" "$progress.tmp" "$dir/slot-$slot.out"' EXIT
export CITADEL_TEST_PROGRESS=$progress
# The command runs as a child without the lock's fd, so a daemon it leaves behind (sccache, a build
# server) can't keep the slot; this shell holds it until the command ends.
export CITADEL_HEAVY_HELD=1
t1=$(us) c0=$(cpu_ticks)
nicer=()
[ -n "$first" ] || { nicer=(nice -n 19); ! command -v ionice >/dev/null || nicer+=(ionice -c 3); }
if [ -z "$first" ] && pinned=$(pin_cpus) && [ -n "$pinned" ]; then
  say "runs on CPUs $pinned only"
  nicer+=("${CITADEL_HEAVY_TASKSET:-taskset}" -c "$pinned")
fi
# The tees close fd 8 too: they must not hold the slot's lock past the command.
if [ "$out" != /dev/null ] && [ ! -t 1 ] && [ ! -t 2 ]; then
  "${nicer[@]}" "$@" 8>&- > >(tee -a "$out" 8>&-) 2> >(tee -a "$out" 8>&- >&2)
  status=$?
  # The tees are not waited for: a caller reading the pipe to its end still gets every line, but a last line can arrive just after this script's own messages.
else
  "${nicer[@]}" "$@" 8>&-
  status=$?
fi
# Free the slot before the history work, so a slow or stuck write can't hold up the line. The holder's files go
# first: once the lock is free the next holder writes its own, which a later clean-up here would delete.
rm -f "$dir/slot-$slot.who" "$waitfile" "$waitfile.tmp" "$progress" "$progress.tmp" "$dir/slot-$slot.out" 2>/dev/null
trap - EXIT
exec 8>&-
history="$dir/history"
[ -z "$forced" ] || reason=forced
# A job that took a free slot at once waited 0 s: the clock also spans its own setup (forks for the slot count, the
# pressure, mem-room), which passed 1 s on a starved CI runner and read as a wait on nothing (#1426).
waited=$(((t1 - t0) / 1000000))
[ "$reason" != none ] || waited=0
line="$(date -d "@$started" +%FT%T%z)	${who//[$'\t\n']/ }	${what//[$'\t\n']/ }	here	$waited	$((($(us) - t1) / 1000000))	$status	${pressure:--}	$((($(cpu_ticks) - c0) / 100))	$reason"
{ printf '%s\n' "$line" >>"$history"; } 2>/dev/null
trim_history
exit "$status"
