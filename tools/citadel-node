#!/usr/bin/env bash
# Runs node so ananicy-cpp's stock `node` rule (nice 16, SCHED_IDLE: deploy/priority.md) matches neither
# it nor the node processes it starts, test files included (#506). ananicy goes by the basename of argv[0],
# so node runs from a link named citadel-node, and a preload (citadel-node.cjs) points process.execPath,
# which node --test and child spawns use, at that link too.
#   tools/citadel-node <node args...>     e.g. tools/citadel-node --test test/
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
if [ -z "${CITADEL_NODE:-}" ] || [ ! -e "$CITADEL_NODE" ]; then
  real=$(NODE_OPTIONS= node -p process.execPath)
  dir="${TMPDIR:-/tmp}/citadel-node-$(id -u)"
  link="$dir/citadel-node"
  if [ "$(readlink "$link" 2>/dev/null)" != "$real" ]; then
    mkdir -p "$dir"
    # A new link moved into place, so a run already using the old one never sees it missing.
    ln -sfn "$real" "$link.$$" && mv -Tf "$link.$$" "$link"
  fi
  export CITADEL_NODE=$link
fi
case " ${NODE_OPTIONS:-} " in
  *citadel-node.cjs*) ;;
  *) export NODE_OPTIONS="--require=\"$here/citadel-node.cjs\"${NODE_OPTIONS:+ $NODE_OPTIONS}" ;;
esac
exec "$CITADEL_NODE" "$@"
