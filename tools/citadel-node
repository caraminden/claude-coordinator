#!/usr/bin/env bash
# Runs node so ananicy-cpp's stock `node` rule (nice 16, SCHED_IDLE: deploy/priority.md) matches neither
# it nor the node processes it starts, test files included (#506). ananicy goes by the basename of argv[0],
# so node runs from a link named citadel-node, and a preload (citadel-node.cjs) points process.execPath,
# which node --test and child spawns use, at that link too.
#   tools/citadel-node <node args...>     e.g. tools/citadel-node --test test/
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
if [ -z "${CITADEL_NODE:-}" ] || [ ! -e "$CITADEL_NODE" ]; then
  real=$(NODE_OPTIONS= node -p process.execPath)
  dir="${TMPDIR:-/tmp}/citadel-node-$(id -u)"
  link="$dir/citadel-node"
  mkdir -p -m 700 "$dir"
  # Under /tmp anyone can make the folder first and point the link at a program of theirs.
  { [ -O "$dir" ] && [ ! -L "$dir" ]; } || { echo "citadel-node: $dir is not a folder of this user's own, so node is not run from it. Remove it, or set TMPDIR" >&2; exit 1; }
  chmod 700 "$dir" # mkdir -m sets it only on a folder it makes
  if [ "$(readlink "$link" 2>/dev/null)" != "$real" ]; then
    # A new link moved into place, so a run already using the old one never sees it missing.
    ln -sfn "$real" "$link.$$" && mv -Tf "$link.$$" "$link"
  fi
  export CITADEL_NODE=$link
fi
case " ${NODE_OPTIONS:-} " in
  *citadel-node.cjs*) ;;
  *) export NODE_OPTIONS="--require=\"$here/citadel-node.cjs\"${NODE_OPTIONS:+ $NODE_OPTIONS}" ;;
esac
# Node's compile cache (CPU win 4, #1541): a test file and every server a test boots strip types from ~270 .ts files
# and compile them again; the cache skips that from the second run on. Under the turn's own temp folder, so it goes
# away with the minion. Keyed by path with a content checksum, so an edited file runs its new code, and an
# unwritable folder falls back silently. A caller's own NODE_COMPILE_CACHE wins. With no TMPDIR there is no cache: /tmp is shared. The live server doesn't pass here.
[ -n "${NODE_COMPILE_CACHE:-}" ] || [ -z "${TMPDIR:-}" ] || export NODE_COMPILE_CACHE="$TMPDIR/citadel-node-cache"
# A test run's file counts for a minion's wait (#545): with CITADEL_TEST_PROGRESS naming a file (citadel-heavy and
# run-tests.sh set it), tools/progress-reporter.ts keeps it up to date beside the run's own reporters. It leaves the
# environment here, so a test that starts its own node --test can't write over the counts. Only when the options
# before the first argument that isn't one include --test and pair every reporter with a destination, as node does
# (ours goes first, and a run with none of its own keeps node's default, spec on stdout); else the run is unchanged.
if [ -n "${CITADEL_TEST_PROGRESS:-}" ]; then
  to=$CITADEL_TEST_PROGRESS
  unset CITADEL_TEST_PROGRESS
  is_test= reporters=0 dests=0
  for a in "$@"; do
    case $a in
      --test) is_test=1 ;;
      --test-reporter-destination | --test-reporter-destination=*) dests=$((dests + 1)) ;;
      --test-reporter | --test-reporter=*) reporters=$((reporters + 1)) ;;
      --) break ;;
      -*) ;;
      *) break ;;
    esac
  done
  if [ -n "$is_test" ] && [ "$reporters" -eq "$dests" ] && [ -r "$here/progress-reporter.ts" ]; then
    extra=(--test-reporter="$here/progress-reporter.ts" --test-reporter-destination=stdout)
    [ "$reporters" -gt 0 ] || extra+=(--test-reporter=spec --test-reporter-destination=stdout)
    export CITADEL_TEST_PROGRESS_TO=$to
    set -- "${extra[@]}" "$@"
  fi
fi
exec "$CITADEL_NODE" "$@"
