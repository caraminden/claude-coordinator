#!/usr/bin/env bash
# Run a few test files and see only what matters (#641), on every turn's PATH like citadel-wait:
#   citadel-test test/a.test.ts [test/b.test.ts ...] [--name '<pattern>'] [--full] [--timeout <seconds>]
# Runs them through the worktree's tools/citadel-node --test with the leak guard (test/leak-guard.ts) and a time
# limit (default 300 s), and prints a line of counts, then each failure's file, name and assertion diff, and the leak
# guard's complaint if any. The full output goes to $TMPDIR/citadel-test.log; --full prints it too. --name keeps the
# tests whose name matches (node's --test-name-pattern). Exits with the tests' status, 124 at the time limit.
# It also runs the repo-wide tests in tools/always-tests.txt (a change anywhere can break them), counted as "+N
# repo-wide"; --name does not filter those (they run in a second pass).
# With no files it runs --affected (#1621), so a bare `citadel-test` is the tests your change touched plus the repo-wide list.
# Rebase onto main first: the picks and the repo-wide guards then match what the ship's CI will run.
# --affected [--base <ref>] adds the files your change touched (#1112, narrowed by #1928): the test files you changed since
# the base (default main, committed or not) and the ones named after a source file you changed (src/x.ts -> test/x.test.ts),
# each printed with what picked it, plus the repo-wide list. The tests that merely use a changed file are CI's, and one line says
# how many. You may name files too (they run as named, however many); with --affected none are needed.
# --wide is the whole pick, as before #1928: every test tools/affected-map.txt maps your changed paths to and every test
# that imports one (format: specs/affected-tests-map.md). The light check on CI's side runner and the ship's gate use it.
# One shared limit (#1928): the test files running at once across every citadel-test run on the box stay within CITADEL_TEST_FILES
# (4 to start, 0 = off), which tools/test-gate.ts moves between CITADEL_TEST_FILES_MIN (2) and CITADEL_TEST_FILES_MAX (8) by the host's
# CPU pressure (its header has the steps). A file waits for a place holding nothing, and starts anyway after CITADEL_TEST_ROOM_WAIT
# seconds (120); a run that waits prints one line saying so. Not on CI (RUNNER_TEMP, GITHUB_ACTIONS), not inside a
# citadel-heavy job (CITADEL_HEAVY_HELD), and land.sh's smoke check runs with CITADEL_TEST_FILES=0.
# The full suite is the land gate's job (tools/land.sh), so it refuses to run on a folder.
set -uo pipefail
say() { echo "citadel-test: $*" >&2; }
usage() { say "usage: citadel-test [--affected [--wide] [--base <ref>]] [test/<name>.test.ts ...] [--name '<pattern>'] [--full] [--timeout <seconds>]"; exit 2; }

root=$(git rev-parse --show-toplevel 2>/dev/null) || { say "run it inside a worktree of Citadel's repo"; exit 2; }
reporter=$root/tools/citadel-test-reporter.ts
[ -f "$reporter" ] || { say "$root has no tools/citadel-test-reporter.ts: it isn't Citadel's repo, or its branch is older than the command (rebase onto main)"; exit 2; }

files=() opts=() full= limit=300 affected= base=main wide= narrow=--narrow
while [ $# -gt 0 ]; do
  case $1 in
    --name) [ $# -ge 2 ] || usage; opts+=("--test-name-pattern=$2"); shift ;;
    --name=*) opts+=("--test-name-pattern=${1#--name=}") ;;
    --full) full=1 ;;
    --affected) affected=1 ;;
    --wide) affected=1 wide=1 narrow= ;;
    --base) [ $# -ge 2 ] || usage; base=$2; shift ;;
    --timeout) [ $# -ge 2 ] && [[ $2 =~ ^[0-9]+$ ]] || usage; limit=$2; shift ;;
    --timeout=*) limit=${1#--timeout=}; [[ $limit =~ ^[0-9]+$ ]] || usage ;;
    -*) say "unknown option $1"; usage ;;
    *) files+=("$1") ;;
  esac
  shift
done
[ ${#files[@]} -gt 0 ] || affected=1 # no files named: what the change can break (#1621)
full_suite="the full suite is the land gate's job (tools/land.sh runs it on CI); if you must run it: citadel-heavy --heavy npm test (on the repo's CI when it has the citadel-heavy workflow)"
if [ -n "$affected" ]; then
  alist=$("$root/tools/citadel-node" "$root/tools/affected.ts" --root "$root" --base "$base" $narrow) ; as=$?
  [ $as -eq 3 ] && { say "the map has no rule for: $(echo "$alist" | sed -n 's/^unmapped\t//p' | tr '\n' ' ')and its @fallback is full: $full_suite"; exit 2; }
  [ $as -eq 0 ] || exit 2
  while IFS=$'\t' read -r kind a b; do
    case $kind in
      run) say "affected: $a  <- $b"; case " ${files[*]-} " in *" $a "*) ;; *) files+=("$a") ;; esac ;;
      wide) [ "$a" -eq 0 ] || say "affected: $a more test file(s) use what you changed; CI runs them (citadel-test --wide runs them here)" ;;
      unmapped) say "affected: no rule covers $a (run the tests that guard it by name)" ;;
      empty) say "affected: nothing has changed from $base" ;;
    esac
  done <<<"$alist"
fi
for f in "${files[@]}"; do
  [ -d "$f" ] && { say "$f is a folder; $full_suite"; exit 2; }
  [ -f "$f" ] || { say "no such file: $f"; exit 2; }
done

# The repo-wide tests: the list's files not already named. CITADEL_TEST_ALWAYS points at another list (test/citadel-test.test.ts).
extra=()
while IFS= read -r line; do
  case $line in ''|'#'*) continue ;; esac
  [ -f "$root/$line" ] || { say "tools/always-tests.txt names $line, which doesn't exist"; exit 2; }
  dup=; for f in "${files[@]}"; do [ "$(realpath "$f")" = "$(realpath "$root/$line")" ] && dup=1; done
  [ -n "$dup" ] || extra+=("$root/$line")
done <"${CITADEL_TEST_ALWAYS:-$root/tools/always-tests.txt}"
[ ${#files[@]} -gt 0 ] || [ ${#extra[@]} -gt 0 ] || { say "affected: nothing to run"; exit 0; }
# With --name the pattern would skip the repo-wide files' tests, so they run apart; otherwise they join the run.
second=(); export CITADEL_TEST_EXTRA=0
if [ ${#opts[@]} -gt 0 ]; then second=("${extra[@]}"); else files+=("${extra[@]}"); export CITADEL_TEST_EXTRA=${#extra[@]}; fi

# Workers by the memory the heavy slice has room for (#1340: one suite at 15 workers took 2-3 GB and tipped everyone
# else): tools/mem-room, 350 MB a worker, at least 1, at most half the cores. CITADEL_TEST_CONCURRENCY wins; without a
# reading node's own default stands.
conc=${CITADEL_TEST_CONCURRENCY:-$("$root/tools/mem-room" workers 2>/dev/null)}
workers=()
if [[ $conc =~ ^[1-9][0-9]*$ ]]; then
  workers=("--test-concurrency=$conc")
  [ -n "${CITADEL_TEST_CONCURRENCY:-}" ] || [ "$conc" -ge $((($(nproc 2>/dev/null || echo 2) + 1) / 2)) ] || say "memory room is short ($("$root/tools/mem-room" mb) MB free for heavy work): running $conc worker(s) at a time"
fi
log=${TMPDIR:-/tmp}/citadel-test.log
err=$(mktemp) out=$(mktemp) failed=$(mktemp); export CITADEL_TEST_FAILED_FILE=$failed CITADEL_TEST_ROOT=$root
gate_note= watch= gate_opts=${NODE_OPTIONS:-}
if [ "${CITADEL_TEST_FILES:-4}" != 0 ] && [ -z "${RUNNER_TEMP:-}${GITHUB_ACTIONS:-}${CITADEL_HEAVY_HELD:-}" ] && command -v flock >/dev/null && [ -f "$root/tools/test-gate.ts" ]; then
  gate_note=$(mktemp -u); gate_opts="${NODE_OPTIONS:-} --import=$root/tools/test-gate.ts"; export CITADEL_TEST_GATE_NOTE=$gate_note
  # Says the wait when it happens, not at the end; read -t on a pipe nobody writes is a sleep with no child to leave behind.
  ( exec {nap}<> <(:); until [ -s "$gate_note" ]; do read -rt 0.3 -u "$nap"; done; say "$(cat "$gate_note")" ) >/dev/null & watch=$!
fi
trap 'rm -f "$err" "$out" "$failed" ${gate_note:+"$gate_note" "$gate_note.n"}; [ -z "$watch" ] || kill "$watch" 2>/dev/null' EXIT
start=$SECONDS
load0=$(cut -d' ' -f1 "${CITADEL_TEST_LOADAVG:-/proc/loadavg}" 2>/dev/null)
# The spec output goes to the log, the short version to stdout, and node's own stderr (the leak guard says its
# piece there) to a file read after. --test-force-exit as in tools/run-tests.sh, so a local run matches the gate's.
# The per-test limit too (CITADEL_TEST_TIMEOUT seconds, #999).
# At the limit only node's runner gets SIGTERM (--foreground), so it names the tests still running before it stops
# its files; a TERM to the whole group could kill a file first, reported as the file failing (#1198). Then the rest
# of the group (what the files started) gets its TERM; the outer timeout KILLs the group if the runner outlasts 10 s.
stop_at() {
  local s=$((10#$1)) pg status
  timeout -s KILL $((s ? s + 10 : 0)) timeout --foreground "$s" "${@:2}" &
  pg=$!
  wait "$pg"; status=$?
  [ $status -eq 124 ] && kill -TERM -- "-$pg" 2>/dev/null
  return $status
}
NODE_OPTIONS=$gate_opts stop_at "$limit" "$root/tools/citadel-node" --test --test-force-exit "${workers[@]}" --test-timeout=$((${CITADEL_TEST_TIMEOUT:-60} * 1000)) --test-global-setup="$root/test/leak-guard.ts" \
  --test-reporter=spec --test-reporter-destination="$log" --test-reporter="$reporter" --test-reporter-destination=stdout \
  "${opts[@]}" "${files[@]}" >"$out" 2>"$err"
status=$?
if [ ${#second[@]} -gt 0 ] && [ $status -ne 124 ]; then
  out2=$(mktemp); trap 'rm -f "$err" "$out" "$out2" "$failed" ${gate_note:+"$gate_note" "$gate_note.n"}; [ -z "$watch" ] || kill "$watch" 2>/dev/null' EXIT
  NODE_OPTIONS=$gate_opts stop_at "$limit" "$root/tools/citadel-node" --test --test-force-exit "${workers[@]}" --test-timeout=$((${CITADEL_TEST_TIMEOUT:-60} * 1000)) --test-global-setup="$root/test/leak-guard.ts" \
    --test-reporter=spec --test-reporter-destination="$log.2" --test-reporter="$reporter" --test-reporter-destination=stdout \
    "${second[@]}" >"$out2" 2>>"$err"
  s2=$?; cat "$log.2" >>"$log"; rm -f "$log.2"
  { echo; echo "repo-wide tests (--name doesn't filter them):"; cat "$out2"; } >>"$out"
  [ $status -eq 0 ] && status=$s2
fi
cat "$err" >>"$log"
[ -n "$full" ] && cat "$log" && echo
cat "$out"
if [ -s "$err" ]; then
  if [ -n "$full" ]; then :
  elif [ "$(wc -l <"$err")" -gt 40 ]; then head -n 40 "$err"; echo "… $(($(wc -l <"$err") - 40)) more lines in the log"
  else cat "$err"
  fi
fi
[ $status -eq 124 ] || [ $status -eq 137 ] && echo "✖ stopped at the time limit, ${limit} s (--timeout <seconds> to change it), after $((SECONDS - start)) s"
echo "full output: $log"

# On a red, one line per failed file when it applies (#1650; Cara, 2026-11-22: "On a red, says if the file is a known flake or the
# box is overloaded, and to rerun it alone once"): tools/known-flakes.ts's answer and the load during the run. Text only: the exit
# code is the tests' own, and nothing reruns. A broken test (red in 20%+ of recent runs) is said broken, never a flake.
if [ $status -ne 0 ] && [ $status -ne 124 ] && [ $status -ne 137 ] && [ -s "$failed" ]; then
  cores=${CITADEL_TEST_CORES:-$(nproc 2>/dev/null || echo 1)}
  # The load when the run started: the end's 1-minute average is mostly the run's own workers, which would blame the box for them.
  load=${load0:-0}
  busy=; awk -v l="$load" -v c="$cores" 'BEGIN { exit !(l >= c) }' && busy="load was $load on $cores cores when the run started"
  mapfile -t red < <(sort -u "$failed")
  verdicts=$(LAND_FLAKE_DB=${LAND_FLAKE_DB:-$HOME/.local/share/claude-coordinator/coordinator.db} "$root/tools/citadel-node" --no-warnings "$root/tools/known-flakes.ts" "$(git -C "$root" rev-parse --abbrev-ref HEAD 2>/dev/null)" "${red[@]}" 2>/dev/null) || true
  hints=
  for f in "${red[@]}"; do
    v=$(grep -F -m1 -e "$f (" -e "not a flake: $f " <<<"$verdicts")
    why=${v#"$f ("}; why=${why%)}
    case $v in
      "broken test, not a flake"*) hints+="  $f: broken, not a flake (${v#broken test, not a flake: $f }); don't rerun and ignore it, fix it or tell the Taskmaster${busy:+ ($busy)}"$'\n' ;;
      "$f (not seen"*|'') [ -n "$busy" ] && hints+="  $f: $busy. Rerun this file alone once; a green rerun is needed before you ignore it"$'\n' ;;
      *) hints+="  $f: known flake (tools/known-flakes.ts: $why)${busy:+; $busy}. Rerun this file alone once; a green rerun is needed before you ignore it"$'\n' ;;
    esac
  done
  [ -n "$hints" ] && printf '\nBefore chasing a red your change may not have caused:\n%s' "$hints"
fi
exit $status
