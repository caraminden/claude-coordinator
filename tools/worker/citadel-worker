#!/bin/bash
# What a worker machine's owner runs on it (Citadel, Build 7; install-worker.sh puts it here). As root:
#   citadel-worker signin [2|3]      sign in to Claude (your 2nd or 3rd linked account: its number), through Claude Code's own sign-in
#   citadel-worker signin-github     sign in to GitHub, through gh's own sign-in
#   citadel-worker caps [--workers N] [--threads N] [--memory GB] [--disk GB]
#   citadel-worker page-caps --threads N --memory GB   the worker's own ask, through sudo: its Machines page's threads and memory
#   citadel-worker folder add <name> <path> [--write]   a folder minions marked for this PC may use, at /host/<name>
#   citadel-worker folder remove <name>
#   citadel-worker folders           the folders, and whether each is mounted
#   citadel-worker status            how it stands, and its last lines
#   citadel-worker remove            take it off this PC (on Windows: wsl --unregister citadel-workers)
set -euo pipefail

die() { echo "citadel-worker: $*" >&2; exit 1; }
r=${CITADEL_TEST_ROOT:-}
# Run through sudo (page-caps), nothing of the caller's environment counts, whatever that sudo keeps: not its PATH either.
if [[ -n ${SUDO_USER:-} ]]; then r='' PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin; fi
etc=$r/etc/citadel-worker
user=citadel-worker
home=$r/home/$user
[[ $(id -u) == 0 ]] || die 'Run this as root (with sudo).'
uid=$(id -u "$user" 2>/dev/null) || die 'No worker is installed here: run the command from the Machines page.'
as() { (cd / && runuser -u "$user" -- env HOME="$home" XDG_RUNTIME_DIR="/run/user/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" "$@"); }

# A program in the worker's image, on this terminal, with the home its minions use: what it signs in to stays there.
inside() {
  local tag
  tag=$(as cat "$home/worker/image-tag" 2>/dev/null) || die 'Its image is not built yet: the Machines page says when it is.'
  as podman run --rm -it --init --userns=keep-id --network=host -e HOME=/home/worker -w /home/worker -v citadel-worker-home:/home/worker:U "$tag" "$@"
}

host_src=$r/mnt/citadel-host

# The folder list's check, as public/worker-agent.mjs hostFolders and folderPath do it (keep them in step;
# test/host-reach.test.ts runs both). A copy here, never an import: root must not run code from the worker's home.
FOLDERS_JS='
const { isAbsolute, normalize } = require("node:path");
const NAME = /^[a-z0-9][a-z0-9_-]{0,39}$/;
const folderPath = (p) => /[\0-\x1f,]/.test(p) ? false : /^[A-Za-z]:\\/.test(p) ? /^[A-Za-z]:\\(?!\\)[^:*?"<>|]*[^\\:*?"<>|\s]$/.test(p) && !/(^|\\)\.\.(\\|$)/.test(p) : isAbsolute(p) && normalize(p) === p && p !== "/" && !p.endsWith("/");
function hostFolders(raw) {
  const folders = [], problems = [];
  if (raw === undefined || raw === null) return { folders, problems };
  if (typeof raw !== "object" || Array.isArray(raw)) return { folders, problems: ["folders must be { <name>: { path, write } }"] };
  for (const [name, f = {}] of Object.entries(raw)) {
    if (!NAME.test(name)) problems.push(`folder "${name}": names are lower-case letters, digits, - and _`);
    else if (typeof f?.path !== "string" || !folderPath(f.path)) problems.push(`folder ${name}: its path must be a full Windows or Linux path to a folder, not a whole drive`);
    else if (f.write !== undefined && typeof f.write !== "boolean") problems.push(`folder ${name}: write must be true or false`);
    else folders.push({ name, path: f.path, write: f.write === true });
  }
  return { folders: folders.slice(0, 20), problems: folders.length > 20 ? [...problems, "only the first 20 folders are used"] : problems };
}
const cfg = JSON.parse(process.env.CFG || "{}");
'

# The owner's folders (Build 7 T8): each mounted here as root, read-only unless the owner said --write. A Windows
# folder is the worker's user's (drvfs uid/gid); a Linux one keeps its own owner, so that user needs access to it. Only a minion marked for this PC gets them, at /host/<name> in its own container (machine-worker.mjs).
mount_folders() {
  local gid line name path write
  gid=$(id -g "$user")
  # What was mounted goes first: a folder taken off the list, or one whose mode changed.
  while read -r line; do umount -l "$line" 2>/dev/null || true; done < <(awk -v d="$host_src/" 'index($5, d) == 1 { print $5 }' /proc/self/mountinfo | sort -r)
  mkdir -p "$host_src"
  chmod 755 "$host_src"
  while IFS=$'\t' read -r name path write; do
    [[ -n $name ]] || continue
    mkdir -p "$host_src/$name"
    if [[ $path =~ ^[A-Za-z]:\\ ]]; then
      mount -t drvfs "$path" "$host_src/$name" -o "uid=$uid,gid=$gid,$( [[ $write == true ]] && echo rw || echo ro )" || { echo "Could not mount $path as $name." >&2; continue; }
    else
      mount --bind "$path" "$host_src/$name" || { echo "Could not mount $path as $name." >&2; continue; }
      [[ $write == true ]] || mount -o remount,bind,ro "$host_src/$name"
    fi
  done < <(CFG="$(cat "$etc/config.json" 2>/dev/null || echo '{}')" node -e "$FOLDERS_JS"'
    const { folders, problems } = hostFolders(cfg.folders);
    for (const p of problems) console.error(p);
    for (const f of folders) console.log([f.name, f.path, f.write].join("\t"));')
}

# Change config.json's folders with a script given FOLDERS as JSON, then mount them again and restart the worker.
edit_folders() {
  local cfg
  cfg=$(CFG="$(cat "$etc/config.json" 2>/dev/null || echo '{}')" ARGS="$1" node -e "$FOLDERS_JS"'
    const [verb, name, path, write] = JSON.parse(process.env.ARGS);
    const folders = { ...(cfg.folders ?? {}) };
    if (verb === "add") folders[name] = { path, write };
    else if (!(name in folders)) { console.error("No folder " + name + " on the list."); process.exit(1); }
    else delete folders[name];
    const { problems } = hostFolders(folders);
    if (problems.length) { console.error(problems.join("\n")); process.exit(1); }
    console.log(JSON.stringify({ ...cfg, folders }, null, 2));') || exit 1
  ( umask 077; printf '%s\n' "$cfg" > "$etc/config.json" )
  chown "root:$user" "$etc/config.json"
  chmod 640 "$etc/config.json"
  mount_folders
  as systemctl --user restart citadel-worker
}

# Everything that user runs, its containers included, is held to $1 threads and $2 GB of memory.
hold_slice() {
  systemctl set-property "user-$uid.slice" "CPUQuota=$(($1 * 100))%" "MemoryMax=${2}G" "MemoryHigh=$(($2 * 1024 * 9 / 10))M"
}

case ${1:-} in
  signin)
    # Account n's own folder, as perigee names it (src/claude-link.ts accountDir): 1 is Claude Code's default.
    n=${2:-1}
    [[ $n =~ ^[123]$ ]] || die 'usage: citadel-worker signin [2|3]: the number of your linked account, as Settings → Your account lists them.'
    echo "Follow the sign-in below for your account $n. When it says you are signed in, type /exit."
    if [[ $n == 1 ]]; then inside claude /login; else inside env CLAUDE_CONFIG_DIR="/home/worker/.claude-$n" claude /login; fi ;;
  signin-github) inside gh auth login --hostname github.com --git-protocol https --web ;;
  caps)
    shift
    restart=true
    given=''
    while [[ $# -gt 0 ]]; do
      case $1 in
        --no-restart) restart=false; shift; continue ;;
        --workers) key=workers min=1 max=64 ;;
        --threads) key=threads min=1 max=1024 ;;
        --memory) key=memory_gb min=2 max=4096 ;;
        --disk) key=disk_gb min=20 max=99999 ;;
        *) die "No setting $1: --workers, --threads, --memory (GB) or --disk (GB)." ;;
      esac
      [[ ${2:-} =~ ^[1-9][0-9]{0,4}$ && $2 -ge $min && $2 -le $max ]] || die "$1 takes a whole number from $min to $max."
      given+="$key=$2 "
      shift 2
    done
    # The file as it is (an image of the owner's own, say) with these over it. The first time, a cap not given is sized from
    # this PC (#2250, public/machine-setup.js workerSize holds the same rule): its threads and memory less a quarter, at
    # least 2 threads and 4 GB kept for its owner and CI, and a minion per 3 of each. A file already there keeps its caps.
    cfg=$(cat "$etc/config.json" 2>/dev/null || echo '{}')
    threads_here=$(getconf _NPROCESSORS_ONLN 2>/dev/null || true)
    memory_here=$(awk '$1 == "MemTotal:" { print int($2 / 1024 / 1024) }' "$r/proc/meminfo" 2>/dev/null || true)
    cfg=$(ROOT="$home/worker" GIVEN="$given" CFG="$cfg" T="$threads_here" M="$memory_here" node -e '
      const c = { root: process.env.ROOT, ...JSON.parse(process.env.CFG) };
      for (const p of process.env.GIVEN.split(" ").filter(Boolean)) c[p.split("=")[0]] = Number(p.split("=")[1]);
      const [T, M] = [Number(process.env.T), Number(process.env.M)];
      const keep = (n, least) => n - Math.max(least, Math.ceil(n / 4));
      const whole = c.threads ?? (T >= 1 ? T : 8);
      c.threads ??= T >= 1 ? Math.min(1024, Math.max(1, keep(T, 2))) : 8;
      c.memory_gb ??= M >= 1 ? Math.min(4096, Math.max(2, keep(M, 4))) : 24;
      c.workers ??= Math.min(64, Math.max(1, Math.floor(Math.min(whole, c.memory_gb) / 3)));
      c.disk_gb ??= 60;
      console.log(JSON.stringify({ workers: c.workers, threads: c.threads, memory_gb: c.memory_gb, disk_gb: c.disk_gb, ...c }, null, 2));')
    num() { CFG="$cfg" node -p "JSON.parse(process.env.CFG).$1"; }
    threads=$(num threads)
    memory=$(num memory_gb)
    ( umask 077; printf '%s\n' "$cfg" > "$etc/config.json" )
    chown "root:$user" "$etc/config.json"
    chmod 640 "$etc/config.json"
    hold_slice "$threads" "$memory"
    if $restart; then as systemctl --user restart citadel-worker; fi
    echo "Caps: $(num workers) minions at once, $threads threads, $memory GB of memory, $(num disk_gb) GB of disk."
    echo "Where its Machines page sets one of these caps, the page's wins: change it there." ;;
  page-caps)
    # The worker's own ask (Build 7, #2085): the threads and memory its owner set on the Machines page, which may be above this
    # PC's own. The one command sudo lets its user run (install-worker.sh's sudoers file), so it takes only this shape, each a
    # whole number within what this PC has, and holds only that user's slice to them: config.json, the PC's own caps, stays
    # as its owner left it, and the worker holds the page's workers and disk itself.
    threads_here=$(getconf _NPROCESSORS_ONLN)
    memory_here=$(awk '$1 == "MemTotal:" { print int($2 / 1024 / 1024) }' "$r/proc/meminfo")
    [[ $threads_here =~ ^[0-9]+$ && $memory_here =~ ^[0-9]+$ ]] || die "Refused: can't tell this PC's threads and memory."
    [[ $# == 5 && $2 == --threads && $4 == --memory ]] || die 'Refused: page-caps takes --threads <n> --memory <GB>, and nothing else.'
    [[ $3 =~ ^[1-9][0-9]{0,4}$ && $3 -le $threads_here ]] || die "Refused: --threads takes a whole number from 1 to $threads_here on this PC."
    [[ $5 =~ ^[1-9][0-9]{0,4}$ && $5 -ge 2 && $5 -le $memory_here ]] || die "Refused: --memory takes a whole number from 2 to $memory_here on this PC."
    hold_slice "$3" "$5"
    echo "This PC's minions now have $3 threads and $5 GB of memory." ;;
  folder)
    case ${2:-} in
      add)
        [[ $# -ge 4 && $# -le 5 && ( $# == 4 || ${5:-} == --write ) ]] || die 'usage: citadel-worker folder add <name> <path> [--write]'
        write=false
        [[ ${5:-} != --write ]] || write=true
        edit_folders "$(node -e 'console.log(JSON.stringify(process.argv.slice(1, 4).concat(process.argv[4] === "true")))' add "$3" "$4" "$write")"
        echo "Minions marked for this PC now see $4 at /host/$3, $( $write && echo 'and can change and delete what is in it' || echo 'read-only' ). Citadel can't undo what they change there: keep your own backup of it." ;;
      remove)
        [[ $# == 3 ]] || die 'usage: citadel-worker folder remove <name>'
        edit_folders "$(node -e 'console.log(JSON.stringify(["remove", process.argv[1]]))' "$3")"
        echo "Removed $3. While a marked minion's turn runs on this PC, its container keeps the folders it started with, for every marked turn that starts beside it; the next one after they have all ended starts without it." ;;
      *) die 'usage: citadel-worker folder add <name> <path> [--write] | folder remove <name>' ;;
    esac ;;
  folders)
    CFG="$(cat "$etc/config.json" 2>/dev/null || echo '{}')" ON="$(awk -v d="$host_src/" 'index($5, d) == 1 { print substr($5, length(d) + 1) }' /proc/self/mountinfo)" node -e "$FOLDERS_JS"'
      const { folders, problems } = hostFolders(cfg.folders);
      const on = new Set(process.env.ON.split("\n"));
      for (const f of folders) console.log("/host/" + f.name + "  " + f.path + "  " + (f.write ? "read-write" : "read-only") + (on.has(f.name) ? "" : "  (not mounted: run citadel-worker mount-folders)"));
      if (!folders.length) console.log("No folders: minions here reach none of this PC.");
      for (const p of problems) console.log("Problem: " + p);' ;;
  mount-folders) mount_folders ;;
  status)
    as systemctl --user --no-pager status citadel-worker || true
    as tail -n 20 "$home/worker.log" ;;
  remove)
    read -rp "This deletes the worker, its sign-ins and everything in $home. Type yes to go on: " sure
    [[ $sure == yes ]] || die 'Nothing was removed.'
    as systemctl --user disable --now citadel-worker || true
    loginctl disable-linger "$user"
    loginctl terminate-user "$user" 2>/dev/null || true
    systemctl disable --now citadel-worker-mounts || true
    sleep 2
    userdel -r "$user"
    rm -rf "${etc:?}" "$r/etc/sudoers.d/citadel-worker" "$r/etc/systemd/system/citadel-worker-mounts.service" "$r/usr/local/bin/citadel-worker" "$r/etc/systemd/system.control/user-$uid.slice.d"
    systemctl daemon-reload
    echo 'Removed. Switch Minion turns off on its row of the Machines page too.' ;;
  *)
    sed -n '2,7s/^# \{0,1\}//p' "$0"
    exit 2 ;;
esac
