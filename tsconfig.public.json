{
  // The front end's type check (#2010): public/**/*.js as pages run it, with the DOM and no Node types. The service worker
  // has its own globals: tsconfig.sw.json. Every script is its own module ("force"), so one file's top-level name can't
  // stand in for a missing import in another. JSDoc here must not import a type from src/ that reaches Node's: that pulls
  // the server into this check and counts its errors twice (declare the type in public/, as progress.js's FinishedStep).
  "extends": "./tsconfig.json",
  // skipLibCheck off: the shapes in public/types*.d.ts are checked too, so a name one forgets to import is an error, not a silent `any` (#2128).
  "compilerOptions": { "lib": ["esnext", "dom", "dom.iterable"], "types": [], "checkJs": true, "moduleDetection": "force", "skipLibCheck": false },
  "include": ["public/**/*.js", "public/types/*.d.ts"],
  "exclude": ["public/sw.js"]
}
